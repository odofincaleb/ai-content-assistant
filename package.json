{
  "name": "my-electron-app",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "homepage": ".",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "react-scripts": "^5.0.1",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "electron": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-dev": "set NODE_ENV=development && electron .",
    "electron-pack": "npm run build && set NODE_ENV=production && electron ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "https-browserify": "^1.0.0",
    "openai": "^5.10.2",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "querystring-es3": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "timers-browserify": "^2.0.12",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "youtube-transcript-api": "^3.0.6",
    "ytdl-core": "^4.11.5"
  }
}
